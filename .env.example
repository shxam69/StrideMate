# ==============================================================================
# STRIDEMATE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (or configure in cloud environment secrets / Render / Vercel)
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CORE CONFIGURATION
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Database (Supabase / Neon / Render)
JDBC_DATABASE_URL=jdbc:postgresql://your-db-host.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password

# Authentication (JWT) - 256-bit minimum secret key
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_12345
JWT_EXPIRATION_MS=86400000

# Frontend URL (CORS origin)
FRONTEND_URL=https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 2. EMERGENCY NOTIFICATION PROVIDER (SPRINGEDGE / MOCK)
# ------------------------------------------------------------------------------
# Provider Mode: 'mock' for local simulation (safe default), 'real' for live delivery
NOTIFICATION_PROVIDER_MODE=mock
SPRINGEDGE_API_KEY=your_springedge_api_key_here
SPRINGEDGE_SMS_SENDER_ID=SPREDG
SPRINGEDGE_API_URL=https://api.springedge.com/v1/sms/send
SPRINGEDGE_WHATSAPP_NUMBER=
SPRINGEDGE_VOICE_NUMBER=

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT & TRAFFIC INTELLIGENCE (OPTIONAL)
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key
TOMTOM_API_KEY=your_tomtom_api_key

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (TRANSACTIONAL OTP & PASSWORD RESET)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@stridemate.app

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE ENVIRONMENT
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-backend.onrender.com/api
