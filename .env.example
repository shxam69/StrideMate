# StrideMate Backend Environment Variables

# Spring Profile
# Set to 'prod' to enable SMTP email service and use application-prod.properties
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Connection String
# Must be in JDBC format (e.g. jdbc:postgresql://host:port/dbname)
# Note: If your provider (like Render) gives you a postgres://... URL, 
# you MUST replace 'postgres://' with 'jdbc:postgresql://' 
JDBC_DATABASE_URL=jdbc:postgresql://your-db-host:5432/stridemate
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# Authentication (JWT)
# A secure, random 256-bit string (e.g., generated via `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough

# Frontend CORS
# The exact URL of the deployed frontend (without trailing slash)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# SMTP Configuration (For Password Reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nievrox.saas@gmail.com
MAIL_PASSWORD=kuyg wgtt jzdy ctlq
MAIL_FROM=noreply@stridemate.app


# StrideMate Frontend Environment Variables (Vite)

# Backend API URL
# The URL of the deployed Spring Boot backend
VITE_API_BASE_URL=https://your-backend-domain.onrender.com/api
