# Spring Boot Backend Environment Variables Example
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
JDBC_DATABASE_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password

# Security & CORS
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_12345
FRONTEND_URL=https://your-app.vercel.app

# Safety Notification Provider (SpringEdge / Mock)
NOTIFICATION_PROVIDER_MODE=mock
SPRINGEDGE_API_KEY=
SPRINGEDGE_SMS_SENDER_ID=SPREDG
SPRINGEDGE_API_URL=https://api.springedge.com/v1/sms/send
SPRINGEDGE_WHATSAPP_NUMBER=
SPRINGEDGE_VOICE_NUMBER=

# Environment & Traffic Intelligence
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=

# Email Delivery
RESEND_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@stridemate.app
